{
  "name": "cli-funnel",
  "version": "0.2.0",
  "description": "Use Claude Code, Codex, Cursor Agent and Antigravity CLIs like an API, on your subscription.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cli-funnel": "dist/bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperTost100/cli-funnel.git",
    "directory": "packages/cli-funnel"
  },
  "homepage": "https://github.com/SuperTost100/cli-funnel#readme",
  "bugs": {
    "url": "https://github.com/SuperTost100/cli-funnel/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor-agent",
    "antigravity",
    "cli",
    "ai",
    "agent",
    "openai-compatible",
    "subscription"
  ]
}
